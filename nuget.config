<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin this repo to nuget.org. The foundation consumes only public packages, so
    we override any machine-global feeds (e.g. a private GitHub Packages feed)
    here and map everything to nuget.org. When a slice starts consuming a
    package from a private feed, add that source plus a package-source-mapping
    pattern scoped to it, rather than widening the `*` mapping.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
