<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PeanutGallery.Engine</RootNamespace>
    <AssemblyName>PeanutGallery.Engine</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Not AOT yet: Microsoft.Extensions.AI derives JSON schemas via reflection.
         The Native-AOT desktop shell (roadmap) uses the source-gen path; the pure
         core stays AOT-clean regardless. Suppress the experimental-API gates the
         OpenAI SDK + MEAI surface so a custom endpoint + IChatClient compiles. -->
    <NoWarn>$(NoWarn);OPENAI001;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeanutGallery.Core\PeanutGallery.Core.csproj" />
  </ItemGroup>
</Project>
